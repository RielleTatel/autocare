DATABASE_URL=postgresql://autocare:autocare@localhost:5432/autocare
REDIS_URL=redis://localhost:6379
FIREBASE_PROJECT_ID=autocare-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@autocare-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Supabase Storage (service-role key is server-only; clients never hold it — see Architecture §7.3)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=autocare
API_PORT=3001
POLICY_VERSION=2026-08-privacy-v1
# PayMongo e-payment (Phase 2 billing) — real adapter used unless NODE_ENV=test, which selects
# the in-memory fake provider adapter instead, so these are unset in dev/test by default.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret
