# Copy to .env and fill in real values. Never commit .env.

# Firebase web SDK config (Firebase console → Project settings → General →
# Your apps → Web app). Read by src/features/auth/staffAuth.ts.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# API base URL (defaults to http://localhost:3001 if unset).
# Use your machine's LAN IP when running on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3001
