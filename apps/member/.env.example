# Copy to .env and fill in real values. Never commit .env.

# API base URL (defaults to http://localhost:3001 if unset)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Google OAuth web client ID from the Firebase console (Authentication →
# Sign-in method → Google → Web SDK configuration). Required for
# GoogleSignin.configure() in src/features/auth/firebaseAuth.ts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Must match the API's POLICY_VERSION (see apps/api DPA consent config).
# Shown on the ConsentScreen as "Policy version {POLICY_VERSION}".
EXPO_PUBLIC_POLICY_VERSION=1
