# Copy to .env and fill in real values. Never commit .env.

# API base URL (defaults to http://localhost:3001 if unset)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Google OAuth web client ID from the Firebase console (Authentication →
# Sign-in method → Google → Web SDK configuration). Required for
# GoogleSignin.configure() in src/features/auth/firebaseAuth.ts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Must match the API's POLICY_VERSION (see apps/api DPA consent config).
# Shown on the ConsentScreen as "Policy version {POLICY_VERSION}".
EXPO_PUBLIC_POLICY_VERSION=1

# Mapbox PUBLIC token (pk.…) — renders the roadside incident map and reverse
# geocodes the pin. Safe to ship in the bundle; scope it to the minimum.
# The separate DOWNLOAD token (sk.…) is build-time only: supply it as
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN on the build machine / as an EAS secret, never here.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_public_token_here
