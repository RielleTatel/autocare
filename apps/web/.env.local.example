# Copy to .env.local and fill in real values. Never commit .env.local.

# Firebase web SDK config (Firebase console → Project settings → General → Your apps → Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# API base URL used by the /api/session route handler.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Symmetric key used to seal/open the ac_session cookie (jose EncryptJWT, dir + A256GCM).
# Must be 32+ characters. Generate a real secret for staging/prod, e.g.:
#   openssl rand -base64 32
SESSION_SECRET=dev-only-please-change-me-32chars-min
