generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  MEMBER
  FLEET_MANAGER
  MECHANIC
  ADVISOR
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OdometerSource {
  MEMBER
  INSPECTION
  TRIP
}

enum OrgType {
  FLEET
  INTERNAL
}

model Organization {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  type           OrgType
  tin            String?
  billingContact String?   @map("billing_contact")
  createdAt      DateTime  @default(now()) @map("created_at")
  members        User[]
  vehicles       Vehicle[]

  @@map("organizations")
}

model User {
  id                     String          @id @default(uuid()) @db.Uuid
  firebaseUid            String          @unique @map("firebase_uid")
  mobile                 String?         @unique
  email                  String?         @unique
  name                   String?
  role                   Role            @default(MEMBER)
  status                 UserStatus      @default(ACTIVE)
  isCertifiedTechnician  Boolean         @default(false) @map("is_certified_technician")
  createdAt              DateTime        @default(now()) @map("created_at")
  consents               ConsentRecord[]
  vehicles               Vehicle[]
  address                String?
  emergencyContactName   String?         @map("emergency_contact_name")
  emergencyContactMobile String?         @map("emergency_contact_mobile")
  orgId                  String?         @map("org_id") @db.Uuid
  org                    Organization?   @relation(fields: [orgId], references: [id])
  erasureRequestedAt     DateTime?       @map("erasure_requested_at")
  dataRequests           DataRequest[]
  subscriptions          Subscription[]
  shifts                 StaffShift[]
  inspections            Inspection[]

  @@map("users")
}

model ConsentRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id])
  policyVersion String    @map("policy_version")
  consentedAt   DateTime  @default(now()) @map("consented_at")
  ip            String?
  withdrawnAt   DateTime? @map("withdrawn_at")

  @@map("consent_records")
}

model Vehicle {
  id                String            @id @default(uuid()) @db.Uuid
  ownerUserId       String?           @map("owner_user_id") @db.Uuid
  owner             User?             @relation(fields: [ownerUserId], references: [id])
  plateNo           String            @unique @map("plate_no")
  make              String
  model             String
  year              Int
  variant           String?
  engineCc          Int?              @map("engine_cc")
  fuelType          String            @map("fuel_type")
  transmission      String
  vin               String?
  color             String?
  currentOdometerKm Int               @default(0) @map("current_odometer_km")
  status            String            @default("ACTIVE")
  createdAt         DateTime          @default(now()) @map("created_at")
  odometerReadings  OdometerReading[]
  orgOwnerId        String?           @map("owner_org_id") @db.Uuid
  orgOwner          Organization?     @relation(fields: [orgOwnerId], references: [id])
  photoUrls         String[]          @default([]) @map("photo_urls")
  orCrUrls          String[]          @default([]) @map("or_cr_urls")
  subscriptions     Subscription[]
  appointments      Appointment[]
  serviceReminders  ServiceReminder[]
  inspections       Inspection[]
  healthScores      HealthScore[]
  certificates      Certificate[]
  workOrders        WorkOrder[]
  recommendations   Recommendation[]

  @@index([ownerUserId, status])
  @@map("vehicles")
}

enum DataRequestType {
  EXPORT
  ERASURE
}

enum DataRequestStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model DataRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  user        User              @relation(fields: [userId], references: [id])
  type        DataRequestType
  status      DataRequestStatus @default(PENDING)
  requestedAt DateTime          @default(now()) @map("requested_at")
  completedAt DateTime?         @map("completed_at")
  resultUrl   String?           @map("result_url")

  @@map("data_requests")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model OdometerReading {
  id            String         @id @default(uuid()) @db.Uuid
  vehicleId     String         @map("vehicle_id") @db.Uuid
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  km            Int
  source        OdometerSource
  recordedAt    DateTime       @default(now()) @map("recorded_at")
  recordedBy    String?        @map("recorded_by") @db.Uuid
  justification String?

  @@map("odometer_readings")
}

// ---------------------------------------------------------------------------
// Phase 2 — Subscription & billing (Data Model §8.3-8.5)
// ---------------------------------------------------------------------------

enum EntitlementType {
  INSPECTION
  PICKUP
  ROADSIDE
  OIL_CHANGE
  TIRE_ROTATION
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PaymentMethod {
  GCASH
  MAYA
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Must exactly match the 8 invoice-lifecycle states (Ruling BIGSTATE).
enum InvoiceStatus {
  INVOICE_ISSUED
  AWAITING_AUTO_CHARGE
  AWAITING_CASH
  RETRYING
  GRACE
  PAID
  PAST_DUE
  SUSPENDED
}

enum SubscriptionPaymentMethod {
  E_PAYMENT
  COD
}

model Plan {
  id              String            @id @default(uuid()) @db.Uuid
  code            String
  name            String
  priceCentavos   BigInt            @map("price_centavos")
  billingInterval BillingInterval   @map("billing_interval")
  lockInMonths    Int               @map("lock_in_months")
  isActive        Boolean           @default(true) @map("is_active")
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at")
  entitlements    PlanEntitlement[]
  subscriptions   Subscription[]

  @@index([code])
  @@map("plans")
}

model PlanEntitlement {
  id                   String          @id @default(uuid()) @db.Uuid
  planId               String          @map("plan_id") @db.Uuid
  plan                 Plan            @relation(fields: [planId], references: [id])
  entitlementType      EntitlementType @map("entitlement_type")
  quantityPerCycle     Int             @map("quantity_per_cycle")
  overagePriceCentavos BigInt          @map("overage_price_centavos")

  @@map("plan_entitlements")
}

// NOTE: migration `20260821112628_subscription_one_active_per_vehicle` adds a partial
// unique index `subscriptions_one_active_per_vehicle` ON subscriptions(vehicle_id) WHERE
// status = 'ACTIVE', enforcing "one ACTIVE subscription per vehicle" (FR-017/BR-08) as a
// DB-level backstop to the check-then-act guard in SubscriptionsService.create. Prisma's
// schema DSL has no syntax for partial/filtered unique indexes, so it is intentionally NOT
// declared here — the migration history is the sole source of truth for it. Do not
// `prisma migrate reset`/regenerate migrations in a way that drops that migration file.
model Subscription {
  id                 String                    @id @default(uuid()) @db.Uuid
  vehicleId          String                    @map("vehicle_id") @db.Uuid
  vehicle            Vehicle                   @relation(fields: [vehicleId], references: [id])
  planId             String                    @map("plan_id") @db.Uuid
  plan               Plan                      @relation(fields: [planId], references: [id])
  userId             String                    @map("user_id") @db.Uuid
  user               User                      @relation(fields: [userId], references: [id])
  status             SubscriptionStatus        @default(ACTIVE)
  startedAt          DateTime                  @map("started_at")
  lockInEndsAt       DateTime                  @map("lock_in_ends_at")
  currentPeriodStart DateTime                  @map("current_period_start")
  currentPeriodEnd   DateTime                  @map("current_period_end")
  paymentMethod      SubscriptionPaymentMethod @map("payment_method")
  cancelRequestedAt  DateTime?                 @map("cancel_requested_at")
  pendingPlanId      String?                   @map("pending_plan_id") @db.Uuid
  entitlementUsages  EntitlementUsage[]
  invoices           Invoice[]

  @@map("subscriptions")
}

model EntitlementUsage {
  id              String          @id @default(uuid()) @db.Uuid
  subscriptionId  String          @map("subscription_id") @db.Uuid
  subscription    Subscription    @relation(fields: [subscriptionId], references: [id])
  entitlementType EntitlementType @map("entitlement_type")
  periodStart     DateTime        @map("period_start")
  usedQty         Int             @default(0) @map("used_qty")
  sourceRef       String?         @map("source_ref")

  @@unique([subscriptionId, periodStart, entitlementType])
  @@map("entitlement_usage")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  workOrderId    String?       @map("work_order_id") @db.Uuid
  workOrder      WorkOrder?    @relation(fields: [workOrderId], references: [id])
  number         String        @unique
  totalCentavos  BigInt        @map("total_centavos")
  status         InvoiceStatus
  dueDate        DateTime      @map("due_date")
  issuedAt       DateTime      @default(now()) @map("issued_at")
  chargeAttempts Int           @default(0) @map("charge_attempts")
  firstFailedAt  DateTime?     @map("first_failed_at")
  pdfObjectPath  String?       @map("pdf_object_path")
  items          InvoiceItem[]
  payments       Payment[]

  @@index([status, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id                String  @id @default(uuid()) @db.Uuid
  invoiceId         String  @map("invoice_id") @db.Uuid
  invoice           Invoice @relation(fields: [invoiceId], references: [id])
  description       String
  qty               Int
  unitPriceCentavos BigInt  @map("unit_price_centavos")
  taxCentavos       BigInt  @default(0) @map("tax_centavos")

  @@map("invoice_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  invoice           Invoice       @relation(fields: [invoiceId], references: [id])
  method            PaymentMethod
  amountCentavos    BigInt        @map("amount_centavos")
  status            PaymentStatus @default(PENDING)
  pspReference      String?       @map("psp_reference")
  collectedByUserId String?       @map("collected_by_user_id") @db.Uuid
  shiftId           String?       @map("shift_id") @db.Uuid
  cashShift         CashShift?    @relation(fields: [shiftId], references: [id])
  clientUuid        String        @unique @map("client_uuid")
  supersedesId      String?       @unique @map("supersedes_id") @db.Uuid
  supersedes        Payment?      @relation("PaymentSupersedes", fields: [supersedesId], references: [id])
  supersededBy      Payment?      @relation("PaymentSupersedes")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([collectedByUserId, shiftId])
  @@map("payments")
}

model CashShift {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  openedAt         DateTime  @default(now()) @map("opened_at")
  closedAt         DateTime? @map("closed_at")
  expectedCentavos BigInt    @default(0) @map("expected_centavos")
  countedCentavos  BigInt?   @map("counted_centavos")
  varianceCentavos BigInt?   @map("variance_centavos")
  payments         Payment[]

  @@map("cash_shifts")
}

model PspWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  rawPayload  Json      @map("raw_payload")
  processedAt DateTime? @map("processed_at")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("psp_webhook_events")
}

model IdempotencyKey {
  key          String   @id
  endpoint     String
  responseHash String   @map("response_hash")
  // Not in the original Task 1 shape — added by Task 4 so a replay can return the
  // *exact* original response, not just verify a hash of it. See idempotency.interceptor.ts.
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Phase 3 — Scheduling & Capacity (M4, FR-041..052, Architecture §7.7)
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model ServiceType {
  id                  String           @id @default(uuid()) @db.Uuid
  code                String           @unique
  name                String
  standardDurationMin Int              @map("standard_duration_min")
  requiredSkills      String[]         @map("required_skills")
  priceCentavos       BigInt           @map("price_centavos")
  entitlementType     EntitlementType? @map("entitlement_type")
  intervalDays        Int?             @map("interval_days")
  intervalKm          Int?             @map("interval_km")
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  appointments        Appointment[]
  serviceReminders    ServiceReminder[]

  @@map("service_types")
}

model ServiceBay {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  capabilities String[]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("service_bays")
}

model StaffShift {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      String
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  skills    String[]
  user      User     @relation(fields: [userId], references: [id])

  @@index([date])
  @@map("staff_shifts")
}

model OperatingHours {
  id              String   @id @default(uuid()) @db.Uuid
  weekday         Weekday?
  dateOverride    String?  @map("date_override")
  openTime        String?  @map("open_time")
  closeTime       String?  @map("close_time")
  walkInBufferPct Int      @default(0) @map("walk_in_buffer_pct")

  @@unique([weekday])
  @@unique([dateOverride])
  @@map("operating_hours")
}

model CapacityBlock {
  id        String   @id @default(uuid()) @db.Uuid
  bayId     String?  @map("bay_id") @db.Uuid
  date      String
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  reason    String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("capacity_blocks")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  vehicleId      String            @map("vehicle_id") @db.Uuid
  serviceTypeId  String            @map("service_type_id") @db.Uuid
  bayId          String?           @map("bay_id") @db.Uuid
  scheduledStart DateTime          @map("scheduled_start")
  scheduledEnd   DateTime          @map("scheduled_end")
  status         AppointmentStatus @default(BOOKED)
  requiresPickup Boolean           @default(false) @map("requires_pickup")
  createdBy      String            @map("created_by") @db.Uuid
  subscriptionId String?           @map("subscription_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id])
  serviceType    ServiceType       @relation(fields: [serviceTypeId], references: [id])

  @@index([scheduledStart, bayId])
  @@index([status, scheduledStart])
  @@map("appointments")
}

// Phase 3 — in-app due-service reminders (FR-047). A minimal, scheduling-scoped table; the general
// notification centre + channel dispatch (SMS/push) arrives in Phase 7 and can read/dispatch these.
model ServiceReminder {
  id            String      @id @default(uuid()) @db.Uuid
  vehicleId     String      @map("vehicle_id") @db.Uuid
  serviceTypeId String      @map("service_type_id") @db.Uuid
  reason        String // TIME | ODOMETER
  createdAt     DateTime    @default(now()) @map("created_at")
  dismissedAt   DateTime?   @map("dismissed_at")
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id])
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])

  @@unique([vehicleId, serviceTypeId])
  @@map("service_reminders")
}

// ===== Phase 4 — Inspection & Vehicle Health Score =====

enum PointStatus {
  GOOD
  MONITOR
  ATTENTION
  CRITICAL
  NOT_APPLICABLE
}

enum PointInputType {
  STATUS
  MEASURED
}

enum ThresholdDirection {
  HIGHER_BETTER
  LOWER_BETTER
}

enum ChecklistStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VhsBand {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_ATTENTION
  CRITICAL
}

enum ScoreConfidence {
  HIGH
  MEDIUM
  LOW
}

enum ScoreOverride {
  NONE
  SAFETY_CRITICAL
  SAFETY_ATTENTION
}

enum CertificateVisibility {
  PRIVATE
  LINK
  REVOKED
}

enum SyncReceiptStatus {
  APPLIED
  DUPLICATE
  REJECTED
}

// Published versions are immutable (FR-101): the checklists service only ever
// mutates DRAFT rows; publish flips status and deactivates the previous active.
model ChecklistVersion {
  id            String              @id @default(uuid()) @db.Uuid
  versionLabel  String              @unique @map("version_label")
  weightVersion String              @map("weight_version")
  status        ChecklistStatus     @default(DRAFT)
  isActive      Boolean             @default(false) @map("is_active")
  publishedAt   DateTime?           @map("published_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  categories    ChecklistCategory[]
  inspections   Inspection[]
  healthScores  HealthScore[]

  @@index([isActive])
  @@map("checklist_versions")
}

model ChecklistCategory {
  id                 String           @id @default(uuid()) @db.Uuid
  checklistVersionId String           @map("checklist_version_id") @db.Uuid
  checklistVersion   ChecklistVersion @relation(fields: [checklistVersionId], references: [id])
  code               String
  label              String
  labelFil           String?          @map("label_fil")
  // Category weights across a version must sum to 100 — enforced by the
  // checklists service on publish + a CI seed e2e (a deferred DB trigger would
  // couple migrations to app-level config semantics for no extra safety).
  weight             Float
  sortOrder          Int              @default(0) @map("sort_order")
  points             ChecklistPoint[]

  @@unique([checklistVersionId, code])
  @@map("checklist_categories")
}

model ChecklistPoint {
  id                     String              @id @default(uuid()) @db.Uuid
  categoryId             String              @map("category_id") @db.Uuid
  category               ChecklistCategory   @relation(fields: [categoryId], references: [id])
  code                   String
  label                  String
  labelFil               String?             @map("label_fil")
  weightInCategory       Float               @map("weight_in_category")
  isSafetyCritical       Boolean             @default(false) @map("is_safety_critical")
  inputType              PointInputType      @map("input_type")
  unit                   String?
  thresholdDirection     ThresholdDirection? @map("threshold_direction")
  thresholdGood          Float?              @map("threshold_good")
  thresholdMonitor       Float?              @map("threshold_monitor")
  thresholdAttention     Float?              @map("threshold_attention")
  recommendation         String
  // One plain-language sentence per status (FR-115 tap-to-explain, §11.6a).
  // Versions with the checklist, so published explanations are immutable.
  templates              Json?
  requiresPhotoOnAdverse Boolean             @default(false) @map("requires_photo_on_adverse")
  notApplicableWhen      String?             @map("not_applicable_when")
  sortOrder              Int                 @default(0) @map("sort_order")
  results                InspectionResult[]

  @@unique([categoryId, code])
  @@map("checklist_points")
}

// Append-only (NFR-054): corrections create a new row via supersedesId.
model Inspection {
  id                 String             @id @default(uuid()) @db.Uuid
  clientUuid         String             @unique @map("client_uuid")
  vehicleId          String             @map("vehicle_id") @db.Uuid
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id])
  appointmentId      String?            @map("appointment_id") @db.Uuid
  mechanicId         String             @map("mechanic_id") @db.Uuid
  mechanic           User               @relation(fields: [mechanicId], references: [id])
  checklistVersionId String             @map("checklist_version_id") @db.Uuid
  checklistVersion   ChecklistVersion   @relation(fields: [checklistVersionId], references: [id])
  odometerKm         Int?               @map("odometer_km")
  startedAt          DateTime?          @map("started_at")
  submittedAt        DateTime?          @map("submitted_at")
  notes              String?
  supersedesId       String?            @unique @map("supersedes_id") @db.Uuid
  supersedes         Inspection?        @relation("InspectionSupersedes", fields: [supersedesId], references: [id])
  supersededBy       Inspection?        @relation("InspectionSupersedes")
  createdAt          DateTime           @default(now()) @map("created_at")
  results            InspectionResult[]
  healthScore        HealthScore?

  @@index([vehicleId, createdAt])
  @@map("inspections")
}

model InspectionResult {
  id            String         @id @default(uuid()) @db.Uuid
  inspectionId  String         @map("inspection_id") @db.Uuid
  inspection    Inspection     @relation(fields: [inspectionId], references: [id])
  pointId       String         @map("point_id") @db.Uuid
  point         ChecklistPoint @relation(fields: [pointId], references: [id])
  pointCode     String         @map("point_code")
  status        PointStatus?
  measuredValue Float?         @map("measured_value")
  notes         String?
  photoUrls     String[]       @default([]) @map("photo_urls")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@unique([inspectionId, pointCode])
  @@map("inspection_results")
}

model HealthScore {
  id                 String           @id @default(uuid()) @db.Uuid
  inspectionId       String           @unique @map("inspection_id") @db.Uuid
  inspection         Inspection       @relation(fields: [inspectionId], references: [id])
  vehicleId          String           @map("vehicle_id") @db.Uuid
  vehicle            Vehicle          @relation(fields: [vehicleId], references: [id])
  score              Int
  rawScore           Float            @map("raw_score")
  band               VhsBand
  confidence         ScoreConfidence
  overrideApplied    ScoreOverride    @default(NONE) @map("override_applied")
  checklistVersionId String           @map("checklist_version_id") @db.Uuid
  checklistVersion   ChecklistVersion @relation(fields: [checklistVersionId], references: [id])
  weightVersion      String           @map("weight_version")
  topDetractors      Json             @default("[]") @map("top_detractors")
  isStale            Boolean          @default(false) @map("is_stale")
  computedAt         DateTime         @default(now()) @map("computed_at")
  categoryScores     CategoryScore[]
  recommendations    Recommendation[]
  certificates       Certificate[]

  @@index([vehicleId, computedAt])
  @@index([isStale, computedAt])
  @@map("health_scores")
}

model CategoryScore {
  id               String      @id @default(uuid()) @db.Uuid
  healthScoreId    String      @map("health_score_id") @db.Uuid
  healthScore      HealthScore @relation(fields: [healthScoreId], references: [id])
  categoryCode     String      @map("category_code")
  label            String
  weight           Float
  score            Float
  applicablePoints Int         @map("applicable_points")
  sortOrder        Int         @default(0) @map("sort_order")

  @@unique([healthScoreId, categoryCode])
  @@map("category_scores")
}

model Recommendation {
  id                    String               @id @default(uuid()) @db.Uuid
  healthScoreId         String               @map("health_score_id") @db.Uuid
  healthScore           HealthScore          @relation(fields: [healthScoreId], references: [id])
  vehicleId             String               @map("vehicle_id") @db.Uuid
  vehicle               Vehicle              @relation(fields: [vehicleId], references: [id])
  pointCode             String               @map("point_code")
  label                 String
  severity              PointStatus
  recommendation        String
  estimatedCostCentavos BigInt?              @map("estimated_cost_centavos")
  // Lifecycle across inspections (FR-069): unresolved recs re-link to a new
  // inspection's finding and bump resurfacedCount instead of duplicating.
  status                RecommendationStatus @default(OPEN)
  resurfacedCount       Int                  @default(0) @map("resurfaced_count")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at")
  workOrderItems        WorkOrderItem[]

  @@index([healthScoreId])
  @@index([vehicleId, status])
  @@map("recommendations")
}

// Admin-editable key/value settings (BR-07 work-order approval threshold, etc.).
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_config")
}

model Certificate {
  id               String                @id @default(uuid()) @db.Uuid
  vehicleId        String                @map("vehicle_id") @db.Uuid
  vehicle          Vehicle               @relation(fields: [vehicleId], references: [id])
  healthScoreId    String                @map("health_score_id") @db.Uuid
  healthScore      HealthScore           @relation(fields: [healthScoreId], references: [id])
  publicToken      String                @unique @map("public_token")
  verificationCode String                @unique @map("verification_code")
  visibility       CertificateVisibility @default(PRIVATE)
  pdfUrl           String?               @map("pdf_url")
  createdAt        DateTime              @default(now()) @map("created_at")
  revokedAt        DateTime?             @map("revoked_at")

  @@index([vehicleId])
  @@map("certificates")
}

// Idempotency ledger for POST /sync/batch: one receipt per client-generated
// outbox entry; replays return the stored receipt without re-applying.
model SyncOutboxReceipt {
  id         String            @id @default(uuid()) @db.Uuid
  clientUuid String            @unique @map("client_uuid")
  userId     String            @map("user_id") @db.Uuid
  entityType String            @map("entity_type")
  op         String
  status     SyncReceiptStatus
  errorCode  String?           @map("error_code")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("sync_outbox_receipts")
}

// ===== Phase 5 — Work Orders & Parts =====

enum WorkOrderStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  QC
  READY
  CLOSED
  CANCELLED
}

enum WorkOrderItemType {
  PART
  LABOR
}

enum ItemApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  DEFERRED
}

enum RecommendationStatus {
  OPEN
  QUOTED
  APPROVED
  DECLINED
  DEFERRED
  RESOLVED
}

enum WasteType {
  USED_OIL
  BATTERY
  FILTER
  TIRE
  COOLANT
}

model Part {
  sku            String          @id
  name           String
  category       String
  costCentavos   BigInt          @map("cost_centavos")
  priceCentavos  BigInt          @map("price_centavos")
  stockQty       Int             @default(0) @map("stock_qty")
  reorderLevel   Int             @default(0) @map("reorder_level")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  workOrderItems WorkOrderItem[]

  @@index([category])
  @@map("parts")
}

model WorkOrder {
  id                String          @id @default(uuid()) @db.Uuid
  number            String          @unique
  vehicleId         String          @map("vehicle_id") @db.Uuid
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id])
  appointmentId     String?         @map("appointment_id") @db.Uuid
  status            WorkOrderStatus @default(DRAFT)
  customerComplaint String?         @map("customer_complaint")
  technicianSummary String?         @map("technician_summary")
  advisorUserId     String          @map("advisor_user_id") @db.Uuid
  inspectionId      String?         @map("inspection_id") @db.Uuid
  stockOverride     Boolean         @default(false) @map("stock_override")
  stockOverrideReason String?       @map("stock_override_reason")
  openedAt          DateTime        @default(now()) @map("opened_at")
  closedAt          DateTime?       @map("closed_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  items             WorkOrderItem[]
  wasteRecords      WasteRecord[]
  invoices          Invoice[]

  @@index([vehicleId, status])
  @@index([status])
  @@map("work_orders")
}

model WorkOrderItem {
  id                String             @id @default(uuid()) @db.Uuid
  workOrderId       String             @map("work_order_id") @db.Uuid
  workOrder         WorkOrder          @relation(fields: [workOrderId], references: [id])
  type              WorkOrderItemType
  partSku           String?            @map("part_sku")
  part              Part?              @relation(fields: [partSku], references: [sku])
  description       String
  qty               Int                @default(1)
  unitPriceCentavos BigInt             @map("unit_price_centavos")
  discountCentavos  BigInt             @default(0) @map("discount_centavos")
  approvalStatus    ItemApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt        DateTime?          @map("approved_at")
  recommendationId  String?            @map("recommendation_id") @db.Uuid
  recommendation    Recommendation?    @relation(fields: [recommendationId], references: [id])
  done              Boolean            @default(false)
  createdAt         DateTime           @default(now()) @map("created_at")

  @@index([workOrderId])
  @@map("work_order_items")
}

model WasteRecord {
  id          String    @id @default(uuid()) @db.Uuid
  clientUuid  String?   @unique @map("client_uuid")
  workOrderId String    @map("work_order_id") @db.Uuid
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  wasteType   WasteType @map("waste_type")
  quantity    Float
  unit        String
  haulerName  String?   @map("hauler_name")
  manifestNo  String?   @map("manifest_no")
  disposedAt  DateTime? @map("disposed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workOrderId])
  @@map("waste_records")
}
