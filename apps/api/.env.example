
# Mapbox server token (NOT the EXPO_PUBLIC_ one) for FR-039 route distance.
MAPBOX_TOKEN=
# Workshop coordinates — the origin of that route. Unset means no distance.
WORKSHOP_LAT=
WORKSHOP_LNG=

# PayMongo credentials stay on the API. Live keys are disabled during development.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_WEBHOOK_SECRET=your_test_webhook_signing_secret
# HTTPS return pages are required for hosted checkout. Returning never settles
# an invoice; the adapter appends its invoice ID and return/cancel outcome.
# A native return page can link back to autocare://payment-result.
# PAYMONGO_SUCCESS_URL=https://your-member-preview.example/payment-result
# PAYMONGO_CANCEL_URL=https://your-member-preview.example/payment-result
# Comma-separated browser preview/application origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
