
# Mapbox server token (NOT the EXPO_PUBLIC_ one) for FR-039 route distance.
MAPBOX_TOKEN=
# Workshop coordinates — the origin of that route. Unset means no distance.
WORKSHOP_LAT=
WORKSHOP_LNG=

# PayMongo credentials stay on the API. Live keys are disabled during development.
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_WEBHOOK_SECRET=your_test_webhook_signing_secret
# Optional HTTPS return pages. A return page can link back to autocare://payment-result;
# returning from checkout never settles an invoice. Configure both URLs together.
# PAYMONGO_SUCCESS_URL=https://your-return-host.example/payments/success
# PAYMONGO_CANCEL_URL=https://your-return-host.example/payments/cancel
