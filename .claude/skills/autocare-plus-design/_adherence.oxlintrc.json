{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/attention/**",
              "components/core/**",
              "components/field/**",
              "components/shell/**",
              "components/subscription/**",
              "components/vhs/**",
              "ui_kits/certificate/**",
              "ui_kits/field-app/**",
              "ui_kits/member-app/**",
              "ui_kits/staff-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Semi Condensed|Inter|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Barlow Semi Condensed, Inter, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttentionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|body|plate|severity|key|ref|className|style|children)$/]",
        "message": "<AttentionItem> doesn't accept that prop. Declared props: id, title, body, plate, severity."
      },
      {
        "selector": "JSXOpeningElement[name.name='AttentionItemRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|plate|severity|showPlate|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AttentionItemRow> doesn't accept that prop. Declared props: title, body, plate, severity, showPlate, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|band|showRange|showFil|style|key|ref|className|style|children)$/]",
        "message": "<BandChip> doesn't accept that prop. Declared props: score, band, showRange, showFil, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|onClose|closeLabel|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, title, children, onClose, closeLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|block|disabled|icon|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, block, disabled, icon, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|deep|danger|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'deep' | 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:member|field)$/]",
        "message": "<Button> size must be one of 'member' | 'field'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|pad|accent|interactive|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, pad, accent, interactive, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:md|lg|none)$/]",
        "message": "<Card> pad must be one of 'md' | 'lg' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|score|weight|points|showStars|compact|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CategoryBar> doesn't accept that prop. Declared props: label, score, weight, points, showStars, compact, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|tone|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, body, tone, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:empty|loading|error)$/]",
        "message": "<EmptyState> tone must be one of 'empty' | 'loading' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|error|hint|mono|size|type|onChange|id|style|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, value, placeholder, error, hint, mono, size, type, onChange, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:member|field)$/]",
        "message": "<FormField> size must be one of 'member' | 'field'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|interval|lockInMonths|inclusions|selected|actionLabel|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<PlanCard> doesn't accept that prop. Declared props: name, price, interval, lockInMonths, inclusions, selected, actionLabel, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute[name.name='interval'] > Literal[value!=/^(?:MONTHLY|QUARTERLY|ANNUAL)$/]",
        "message": "<PlanCard> interval must be one of 'MONTHLY' | 'QUARTERLY' | 'ANNUAL'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plate'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|style|key|ref|className|style|children)$/]",
        "message": "<Plate> doesn't accept that prop. Declared props: children, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plate'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|chip|plain)$/]",
        "message": "<Plate> variant must be one of 'outline' | 'chip' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|band|confidence|isStale|daysSinceInspection|size|variant|style|key|ref|className|style|children)$/]",
        "message": "<ScoreGauge> doesn't accept that prop. Declared props: score, band, confidence, isStale, daysSinceInspection, size, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreGauge'] > JSXAttribute[name.name='confidence'] > Literal[value!=/^(?:HIGH|MEDIUM|LOW)$/]",
        "message": "<ScoreGauge> confidence must be one of 'HIGH' | 'MEDIUM' | 'LOW'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreGauge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:member|field)$/]",
        "message": "<ScoreGauge> variant must be one of 'member' | 'field'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|band|size|style|key|ref|className|style|children)$/]",
        "message": "<StarRating> doesn't accept that prop. Declared props: score, band, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChoice'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|selected|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<StatusChoice> doesn't accept that prop. Declared props: status, selected, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|info|success|warn|danger|solid|solidDeep)$/]",
        "message": "<StatusPill> tone must be one of 'neutral' | 'info' | 'success' | 'warn' | 'danger' | 'solid' | 'solidDeep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SyncBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:pendingCount|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SyncBanner> doesn't accept that prop. Declared props: pendingCount, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|key|ref|className|style|children)$/]",
        "message": "<TabBarTab> doesn't accept that prop. Declared props: key, label, icon."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
